{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "P3pp3rF1y",
    "Salandora",
    "Huziyang520"
  ],
  "license": "${mod_license}",
  "icon": "${mod_logo_file}",
  "contact": {
    "homepage": "https://github.com/Huziyang520/Sophisticated-Core-Unofficial-Fabric-Continuation",
    "issues": "https://github.com/Huziyang520/Sophisticated-Core-Unofficial-Fabric-Continuation/issues"
  },
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.p3pp3rf1y.sophisticatedcore.SophisticatedCore"
    ],
    "client": [
      "net.p3pp3rf1y.sophisticatedcore.client.ClientEventHandler"
    ],
    "jei_mod_plugin": [
      "net.p3pp3rf1y.sophisticatedcore.compat.jei.CorePlugin"
    ],
    "modmenu": [
      "net.p3pp3rf1y.sophisticatedcore.client.compat.ModMenuIntegration"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "accessWidener": "${mod_id}.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${fabric_minecraft_range}",
    "java": ">=${java_version}",
    "cloth-config": ">=26.3.158"
  },
  "recommends": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "badges": [
        "library"
      ],
      "links": {
        "sophisticatedcore.link.feedback": "https://issue.mengcai.online/"
      }
    },
    "loom:injected_interfaces": {
      "net/minecraft/client/gui/screens/inventory/AbstractContainerScreen": [
        "net/p3pp3rf1y/sophisticatedcore/extensions/client/gui/screens/inventory/SophisticatedAbstractContainerScreen"
      ],
      "net/minecraft/world/entity/Entity": [
        "net/p3pp3rf1y/sophisticatedcore/extensions/entity/SophisticatedEntity"
      ],
      "net/minecraft/world/entity/player/Player": [
        "net/p3pp3rf1y/sophisticatedcore/extensions/entity/SophisticatedPlayer"
      ],
      "net/minecraft/world/inventory/Slot": [
        "net/p3pp3rf1y/sophisticatedcore/extensions/inventory/SophisticatedSlot"
      ],
      "net/minecraft/world/item/Item": [
        "net/p3pp3rf1y/sophisticatedcore/extensions/item/SophisticatedItem"
      ],
      "net/minecraft/world/item/ItemStack": [
        "net/p3pp3rf1y/sophisticatedcore/extensions/item/SophisticatedItemStack",
        "net/p3pp3rf1y/sophisticatedcore/extensions/component/SophisticatedMutableDataComponentHolder"
      ],
      "net/minecraft/world/level/Level": [
        "net/p3pp3rf1y/sophisticatedcore/extensions/world/SophisticatedLevel"
      ],
      "net/minecraft/world/level/block/Block": [
        "net/p3pp3rf1y/sophisticatedcore/extensions/block/SophisticatedBlock"
      ],
      "net/minecraft/world/level/block/state/BlockState": [
        "net/p3pp3rf1y/sophisticatedcore/extensions/block/SophisticatedBlockState"
      ],
      "net/minecraft/world/level/block/entity/BlockEntity": [
        "net/p3pp3rf1y/sophisticatedcore/extensions/block/entity/SophisticatedBlockEntity"
      ],
      "net/minecraft/core/component/DataComponentHolder": [
        "net/p3pp3rf1y/sophisticatedcore/extensions/component/SophisticatedDataComponentHolder"
      ],
      "net/minecraft/world/item/component/ItemContainerContents": [
        "net/p3pp3rf1y/sophisticatedcore/extensions/item/component/SophisticatedItemContainerContents"
      ]
    }
  }
}
